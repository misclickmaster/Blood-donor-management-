{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Flask (LifeStream)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "1",
                "DB_TYPE": "mysql"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload",
                "--host=127.0.0.1",
                "--port=5000"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Python: Run app.py Directly",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Setup MySQL Database",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/setup_mysql.py",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
